---
import { LINKS } from "../lib/constants";

interface Props {
  lang: "it" | "en";
  title: string;
  description: string;
  canonicalPath: "/" | "/it/";
}

const { lang, title, description, canonicalPath } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(canonicalPath, site).toString();
const englishUrl = new URL("/", site).toString();
const italianUrl = new URL("/it/", site).toString();
const imageUrl = new URL("/og-image.png", site).toString();
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Silvio Ceccarini",
  url: englishUrl,
  image: imageUrl,
  jobTitle: "Senior Freelance Software Engineer",
  sameAs: [LINKS.linkedin, LINKS.github],
  nationality: {
    "@type": "Country",
    name: "Italy",
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#11110f" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="it" href={italianUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={lang === "it" ? "it_IT" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
