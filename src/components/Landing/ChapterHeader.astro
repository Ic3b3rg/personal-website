---
interface Props {
  index: string;
  title: string;
  subtitle?: string;
}

const { index, title, subtitle } = Astro.props;
---

<header class="manual-chapter__header">
  <span aria-hidden="true">{index}</span>
  <div>
    <h2>{title}</h2>
    {subtitle && <h3>{subtitle}</h3>}
  </div>
</header>
