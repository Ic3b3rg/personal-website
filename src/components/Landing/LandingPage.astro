---
import { LINKS } from "../../lib/constants";
import ChapterHeader from "./ChapterHeader.astro";
import FaqList from "./FaqList.astro";
import LandingActions from "./LandingActions.astro";
import ProjectFlowFigure from "./ProjectFlowFigure.astro";
import ProjectShowcase from "./ProjectShowcase.astro";
import type { LandingCopy } from "./copy";
import "./landing.css";

interface Props {
  copy: LandingCopy;
  alternateLanguageHref: string;
}

const { copy, alternateLanguageHref } = Astro.props;
const { labels } = copy;
const currentYear = new Date().getFullYear();
---

<div class="manual" data-landing="manual">
  <a class="landing-skip-link" href="#main-content">{labels.skip}</a>

  <header class="manual-header">
    <a href="#top" class="manual-mark" aria-label={labels.home}>
      <img
        class="manual-mark__avatar"
        src="/silvio-avatar.35c8d6f7.png"
        alt=""
        width="38"
        height="38"
        decoding="async"
      />
    </a>
    <nav aria-label={labels.navigation}>
      <a href="#services">{labels.services}</a>
      <a href="#projects">{labels.projects}</a>
      <a href="#recommendations">{labels.recommendations}</a>
      <a class="manual-header__faq" href="#faq">{labels.faq}</a>
      <a
        class="manual-header__language"
        href={alternateLanguageHref}
        hreflang={copy.language === "it" ? "en" : "it"}
        lang={copy.language === "it" ? "en" : "it"}
        >{labels.alternateLanguage}</a
      >
      <a
        class="landing-button manual-header__cta"
        href={LINKS.calDotCom}
        target="_blank"
        rel="noopener noreferrer">{copy.book}</a
      >
    </nav>
  </header>

  <main id="main-content">
    <section class="manual-cover" id="top" data-manual-chapter={labels.cover}>
      <div class="manual-register manual-register--top" aria-hidden="true">
      </div>
      <p class="manual-cover__role">{copy.role}</p>
      <div class="manual-cover__feature">
        <div class="manual-cover__pitch">
          <h1>{copy.headline}</h1>
          <div class="manual-cover__conversion">
            <p class="manual-proof">{copy.proof}</p>
            <LandingActions book={copy.book} email={copy.email} />
          </div>
        </div>
        <ProjectFlowFigure
          flowLabel={labels.projectFlow}
          pathLabel={labels.projectPath}
          stages={labels.projectStages}
        />
      </div>
      <div class="manual-cover__footer">
        <div
          class="manual-copy-stack manual-copy-stack--hero manual-cover__lead"
        >
          <p>{copy.heroBody[0]}</p>
        </div>
        <div class="manual-copy-stack manual-cover__detail">
          {copy.heroBody.slice(1).map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <div class="manual-flow-copy">
        <h2
          class="manual-flow-copy__title"
          aria-label={copy.flowTitle}
          data-flow-title
        >
          <span data-flow-stage>{labels.projectStages[0]}</span>
          {
            labels.projectStages.slice(1).map((stage) => (
              <span class="manual-flow-copy__step">
                <svg
                  class="manual-flow-connector"
                  viewBox="0 0 48 12"
                  aria-hidden="true"
                  focusable="false"
                  data-flow-connector
                >
                  <circle cx="2" cy="6" r="1.5" />
                  <path d="M5 6H46M40 1.5 47 6l-7 4.5" />
                </svg>
                <span data-flow-stage>{stage}</span>
              </span>
            ))
          }
        </h2>
        <p>{copy.flowBody}</p>
      </div>
      <div class="manual-register manual-register--bottom" aria-hidden="true">
      </div>
    </section>

    <section
      class="manual-profile"
      aria-label={labels.profile}
      data-manual-chapter={labels.profile}
    >
      <div class="manual-profile__situations">
        {copy.introduction.slice(0, 3).map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="manual-profile__method">
        <div class="manual-copy-stack manual-profile__method-lead">
          {copy.introduction.slice(3, 5).map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="manual-copy-stack manual-profile__method-detail">
          {copy.introduction.slice(5).map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section
      class="manual-chapter"
      id="services"
      data-manual-chapter={`01 / ${labels.services}`}
    >
      <ChapterHeader
        index="01"
        title={copy.services[0].title}
        subtitle={copy.services[0].subtitle}
      />
      <div class="manual-chapter__body manual-chapter__body--service">
        <div class="manual-copy-stack manual-copy-stack--large">
          {copy.services[0].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <aside>
          <span>{labels.from}</span>
          <strong>{labels.definition}</strong>
          <span>{labels.to}</span>
          <strong>{labels.release}</strong>
        </aside>
      </div>
    </section>

    <section class="manual-chapter" data-manual-chapter={`02 / ${labels.team}`}>
      <ChapterHeader
        index="02"
        title={copy.services[1].title}
        subtitle={copy.services[1].subtitle}
      />
      <div class="manual-chapter__body manual-chapter__body--team">
        <div class="manual-copy-stack manual-copy-stack--large">
          {copy.services[1].paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <ol class="manual-team-spec" data-team-flow>
          {
            copy.services[1].pillars?.map((pillar, index) => (
              <li data-team-node>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{pillar.title}</h3>
                  <p>{pillar.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      class="manual-chapter manual-chapter--orange"
      data-manual-chapter={`03 / ${labels.method}`}
    >
      <ChapterHeader
        index="03"
        title={copy.approachTitle}
        subtitle={copy.approachSubtitle}
      />
      <div class="manual-chapter__body manual-chapter__body--narrative">
        <div class="manual-copy-stack manual-copy-stack--large">
          {copy.approachParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section
      class="manual-chapter"
      data-manual-chapter={`04 / ${labels.scope}`}
    >
      <ChapterHeader
        index="04"
        title={copy.capabilitiesTitle}
        subtitle={copy.capabilitiesSubtitle}
      />
      <div class="manual-chapter__body manual-chapter__body--capabilities">
        <div class="manual-copy-stack">
          {copy.capabilitiesParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <ol data-capabilities-list>
          {
            copy.capabilityItems.map((capability, index) => (
              <li data-capability>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{capability.title}</h3>
                  <p>{capability.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      class="manual-chapter manual-work"
      id="projects"
      data-manual-chapter={`05 / ${labels.work}`}
    >
      <ChapterHeader index="05" title={copy.projectsTitle} />
      <ProjectShowcase projects={copy.projects} />
    </section>

    <section
      class="manual-chapter manual-recommendations"
      id="recommendations"
      data-manual-chapter={`06 / ${labels.trust}`}
    >
      <ChapterHeader index="06" title={copy.recommendationsTitle} />
      <div class="manual-quotes">
        {
          copy.recommendations.map((recommendation) => (
            <blockquote>
              <p>“{recommendation.quote}”</p>
              <cite>{recommendation.initials}</cite>
            </blockquote>
          ))
        }
      </div>
    </section>

    <section
      class="manual-chapter manual-contact"
      id="contact"
      data-manual-chapter={`07 / ${labels.contact}`}
    >
      <header class="manual-contact__header">
        <span aria-hidden="true">07</span>
        <div>
          <p>{copy.contactPrompt}</p>
          <h2>{copy.contactLead}</h2>
          <h3>{copy.contactTitle}</h3>
        </div>
      </header>
      <div class="manual-contact__body">
        <div class="manual-copy-stack manual-copy-stack--large">
          {copy.contactParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <LandingActions book={copy.book} email={copy.email} />
      </div>
    </section>

    <section
      class="manual-chapter manual-faq"
      id="faq"
      data-manual-chapter={`08 / ${labels.questions}`}
    >
      <ChapterHeader index="08" title={copy.faqTitle} />
      <FaqList faqs={copy.faqs} />
    </section>
  </main>

  <footer class="manual-footer">
    <div class="manual-footer__meta">
      <span>Silvio Ceccarini · {copy.footerLocation} · {currentYear}</span>
      <nav aria-label={labels.social}>
        <a href={LINKS.linkedin} target="_blank" rel="me noopener noreferrer"
          >LinkedIn</a
        >
        <a href={LINKS.github} target="_blank" rel="me noopener noreferrer"
          >GitHub</a
        >
      </nav>
    </div>
  </footer>

  <div class="manual-running-state" aria-hidden="true" data-manual-state>
    {labels.cover}
  </div>
</div>

<script>
  import { initLandingMotion } from "./landing-motion";

  initLandingMotion();
</script>
