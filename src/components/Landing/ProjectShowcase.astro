---
import type { LandingCopy } from "./copy";

interface Props {
  projects: LandingCopy["projects"];
}

const { projects } = Astro.props;
---

<ul class="manual-projects">
  {
    projects.map((project) => (
      <li>
        <article class="manual-project">
          <div class="manual-project__identity">
            <img
              src={project.logoSrc}
              alt=""
              width="240"
              height="80"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="manual-project__content">
            <p class="manual-project__context">{project.context}</p>
            <h3>{project.name}</h3>
            <div class="manual-copy-stack manual-copy-stack--compact">
              {project.description.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
            <a
              class="landing-text-link"
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {project.linkLabel}
            </a>
          </div>
        </article>
      </li>
    ))
  }
</ul>
